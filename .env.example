# =============================================================================
# OpenClaw Environment Variables – set these in Railway Dashboard (Variables tab)
# =============================================================================
# Copy this to .env for local docker-compose only. Never commit .env to Git.
# For Railway: Add each variable in Project → Service → Variables
# =============================================================================

# ── AI Provider (at least one required) ─────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENCODE_API_KEY=

# Primary model override (optional): anthropic/claude-haiku-4-5, anthropic/claude-opus-4-6
OPENCLAW_PRIMARY_MODEL=anthropic/claude-haiku-4-5

# ── HTTP Basic Auth (REQUIRED for public deployment) ────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=

# ── Gateway token (for API/Claude Code/Cursor; set for stable access) ───────
OPENCLAW_GATEWAY_TOKEN=

# ── Web Search (Brave API) ──────────────────────────────────────────────────
BRAVE_API_KEY=

# ── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DM_POLICY=allowlist
TELEGRAM_ALLOW_FROM=
TELEGRAM_GROUP_POLICY=allowlist

# ── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_DM_POLICY=allowlist
WHATSAPP_ALLOW_FROM=
WHATSAPP_SELF_CHAT_MODE=true
WHATSAPP_GROUP_POLICY=allowlist

# ── Storage (Railway volume mounts to /data) ─────────────────────────────────
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace

# ── Hooks (optional, for webhooks) ───────────────────────────────────────────
# HOOKS_ENABLED=true
# HOOKS_TOKEN=
